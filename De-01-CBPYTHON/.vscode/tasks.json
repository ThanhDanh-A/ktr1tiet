{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Cham diem tu dong - De 01 CBPYTHON",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["autograde_de1_v2.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Kiem tra logic bo cham",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "unittest", "-v", "test_autograder.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Tu kiem tra 10 bai",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["kiem_thu.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
